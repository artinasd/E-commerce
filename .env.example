# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ecommerce_app
DB_PASSWORD=change-me
DB_NAME=ecommerce
DB_CONNECTION_LIMIT=10

# Authentication
AUTH_SECRET=replace-with-a-long-random-secret

# Internal reconciliation
# Used by the scheduled /api/internal/reconcile endpoint.
# Set this to a long random secret and configure the same value in the deployment environment.
RECONCILIATION_SECRET=replace-with-a-long-random-secret

# Payments
# Keep disabled until a real gateway adapter is installed and configured.
# Supported now: disabled
# Future examples: zarinpal, idpay, ...
PAYMENT_PROVIDER=disabled
